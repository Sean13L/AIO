DATABASE_URL="postgres://postgres:postgres@localhost:5432/syllabus_assistant"

# NextAuth — generate your own: `openssl rand -base64 32` (or `node -e
# "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Never reuse a secret across environments.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# File storage (uploaded syllabi and lecture slides) — Cloudflare R2,
# S3-compatible. Leave all of these unset for local dev: uploads fall back
# to local disk under web/.data/ (see lib/storage.ts). Required in
# production (Vercel has no writable persistent disk).
# R2_ACCOUNT_ID + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY come from an R2 API
# token (Cloudflare dashboard -> R2 -> Manage API Tokens). R2_BUCKET_NAME is
# the bucket you create. R2_PUBLIC_URL is the bucket's public base URL
# (either its r2.dev subdomain with public access enabled, or a custom
# domain) — files are served at "<R2_PUBLIC_URL>/<namespace>/<filename>".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# triggers /api/cron/generate-previews (see vercel.json) — generate the
# same way as NEXTAUTH_SECRET. Leave unset locally; the cron route skips
# the check when it's not set, so you can hit it directly while testing.
CRON_SECRET=

# How the lecture-preview cron decides a lecture is "coming up soon" — see
# app/api/cron/generate-previews/route.ts. Defaults to 48 if unset.
PREVIEW_LEAD_HOURS=48

# Google OAuth — leave unset to hide the "Continue with Google" button.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client, Web application) with redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email — leave unset and the link is logged to the server
# console instead of emailed (dev-mode fallback, see lib/sendVerificationEmail.ts).
# Get a key at https://resend.com if you want real emails sent.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Claude API — leave unset and syllabus extraction / lecture previews fall
# back to local heuristic mocks (mockExtractSyllabus.ts, mockGeneratePreview.ts).
# Get a key at https://console.anthropic.com. Required for real extraction.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
