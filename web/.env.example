DATABASE_URL="postgres://postgres:postgres@localhost:5432/syllabus_assistant"

# NextAuth — generate your own: `openssl rand -base64 32` (or `node -e
# "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Never reuse a secret across environments.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# File storage (uploaded syllabi and lecture slides) — Vercel Blob. Leave
# unset for local dev: uploads fall back to local disk under web/.data/
# (see lib/storage.ts). Required in production (Vercel has no writable
# persistent disk). Connect a Blob store to the project in the Vercel
# dashboard (Storage -> Create Database -> Blob) and it wires up access
# automatically — no separate account or credit card needed, unlike
# Cloudflare R2 (the originally planned backend). Newer projects get
# OIDC-based auth (BLOB_STORE_ID + an auto-injected identity token) instead
# of this token var — leave both unset locally either way.
BLOB_READ_WRITE_TOKEN=

# Secret Vercel Cron sends as "Authorization: Bearer <value>" when it
# triggers /api/cron/generate-previews (see vercel.json) — generate the
# same way as NEXTAUTH_SECRET. Leave unset locally; the cron route skips
# the check when it's not set, so you can hit it directly while testing.
# REQUIRED in production — the route refuses to run unauthenticated
# (503) when NODE_ENV=production and this is unset, so anyone who finds
# the URL can't trigger it. Set this in the Vercel dashboard.
CRON_SECRET=

# How the lecture-preview cron decides a lecture is "coming up soon" — see
# app/api/cron/generate-previews/route.ts. Defaults to 48 if unset.
PREVIEW_LEAD_HOURS=48

# Google OAuth — shared by two features, both gated on these two vars
# being set: (1) the "Continue with Google" sign-in button (lib/auth.ts),
# and (2) "Connect Google Calendar" instant sync (lib/calendar/googleCalendar.ts,
# owner-only — see CLAUDE.md). Create credentials at
# https://console.cloud.google.com/apis/credentials (OAuth client, Web
# application). Add BOTH redirect URIs (one per feature):
#   http://localhost:3000/api/auth/callback/google
#   http://localhost:3000/api/calendar-feed/google/callback
# Also enable the Google Calendar API for the project (APIs & Services ->
# Enabled APIs -> + Enable APIs -> "Google Calendar API") — the sign-in
# flow works without it, but "Connect Google Calendar" will fail until
# it's on.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email — leave unset and the link is logged to the server
# console instead of emailed (dev-mode fallback, see lib/sendVerificationEmail.ts).
# Get a key at https://resend.com if you want real emails sent.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Gemini API — leave unset and syllabus extraction / lecture previews fall
# back to local heuristic mocks (mockExtractSyllabus.ts, mockGeneratePreview.ts).
# Get a free key (no card, no expiration) at https://aistudio.google.com/apikey.
# Chosen over Anthropic's API for this project specifically because it has an
# ongoing free tier — Anthropic's is a one-time $5 trial credit, not free
# long-term. Required for real (non-mock) extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
