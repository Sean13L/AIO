generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model calendar_feeds {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @db.Uuid
  feed_token            String                  @unique
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  calendar_sync_targets calendar_sync_targets[]
}

model calendar_sync_targets {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feed_id                 String           @db.Uuid
  target_type             sync_target_type
  label                   String?
  google_access_token     String?
  google_refresh_token    String?
  google_token_expires_at DateTime?        @db.Timestamptz(6)
  created_at              DateTime         @default(now()) @db.Timestamptz(6)
  calendar_feeds          calendar_feeds   @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model courses {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  course_code String
  course_name String
  semester    String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items       items[]
  lectures    lectures[]
  syllabi     syllabi[]

  @@index([user_id], map: "idx_courses_user")
}

model extracurriculars {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  content    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model items {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String      @db.Uuid
  name        String
  type        item_type
  due_at      DateTime    @db.Timestamptz(6)
  is_datetime Boolean     @default(false)
  weight      String?
  notes       String?
  status      item_status @default(not_started)
  source      item_source @default(extracted)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  courses     courses     @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_items_course")
  @@index([due_at], map: "idx_items_due_at")
}

model lectures {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id           String                @db.Uuid
  scheduled_at        DateTime              @db.Timestamptz(6)
  week_number         Int?
  topics              String?
  slides_url          String?
  preview_status      preview_status        @default(not_generated)
  preview_content     String?
  // Accumulated from the browser's Web Speech API while a lecture is being
  // recorded live (see LecturePage) — null until the first recording session
  // is saved. Free text, not structured, since speech-to-text output has no
  // natural schema beyond "what was said".
  transcript          String?
  transcript_summary  String?
  // The student's own notes for this session — typed/pasted on the lecture
  // page, or imported from a file (only the extracted text is kept, the
  // file itself isn't stored). Selectable as a content type when building a
  // study guide, alongside topics/slides/transcript.
  notes               String?
  // Same meaning as items.source: extracted from a syllabus schedule, or
  // added by hand on the course page.
  source              item_source           @default(extracted)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  courses             courses               @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  study_guide_sources study_guide_sources[]

  @@index([course_id], map: "idx_lectures_course")
  @@index([scheduled_at], map: "idx_lectures_scheduled_at")
}

// One row per generated study guide. `content` is the final AI output,
// self-contained once generated — study_guide_sources below is metadata
// (which lectures/content types went in) for display, not something the
// content depends on at read time. Owned directly by the user (not via a
// course relation) since one guide can pull from lectures across several
// courses.
model study_guides {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                @db.Uuid
  title                String
  // Free-text emphasis the user gave at generation time (e.g. "focus on
  // definitions") — persisted so Regenerate can reuse or let them tweak it,
  // instead of asking them to retype it every time.
  focus                String?
  // Extracted/pasted text from files and/or pasted text the user supplied
  // at generation time to supplement the lecture material (e.g. their own
  // course notes) — concatenated into one blob, not per-file, since it's
  // only ever read as a single extra section. Persisted (not just used
  // transiently) so Regenerate can fold it back in again; the original
  // uploaded file(s), if any, are never stored — only their extracted text.
  notes                String?
  content              String
  used_mock            Boolean               @default(false)
  // Alternate study formats generated FROM this guide's content (not from
  // the original lectures directly) — null until first generated. Kept as
  // JSON on the guide itself, same "generate in place, overwrite on
  // regenerate" pattern as lectures.preview_content, rather than separate
  // tables, since each guide has at most one flashcard set and one quiz.
  flashcards           Json?
  flashcards_used_mock Boolean               @default(false)
  quiz                 Json?
  quiz_used_mock       Boolean               @default(false)
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  user                 User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sources              study_guide_sources[]

  @@index([user_id], map: "idx_study_guides_user")
}

// Which lecture(s) and which content type(s) from each (topics / slides /
// transcript) a study guide was built from — join-table metadata, not the
// generated content itself. Cascades if the source lecture is later
// deleted; the guide's own `content` is unaffected either way.
model study_guide_sources {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  study_guide_id      String       @db.Uuid
  lecture_id          String       @db.Uuid
  included_topics     Boolean      @default(false)
  included_slides     Boolean      @default(false)
  included_transcript Boolean      @default(false)
  included_notes      Boolean      @default(false)
  study_guides        study_guides @relation(fields: [study_guide_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lectures            lectures     @relation(fields: [lecture_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([study_guide_id], map: "idx_study_guide_sources_guide")
  @@index([lecture_id], map: "idx_study_guide_sources_lecture")
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model syllabi {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id      String   @db.Uuid
  file_url       String
  raw_extraction Json?
  uploaded_at    DateTime @default(now()) @db.Timestamptz(6)
  courses        courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model todos {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  title            String
  done             Boolean   @default(false)
  // Optional, unlike items.due_at — a todo is a lighter task that may or may
  // not carry a deadline (Apple Reminders-style: dated and undated items
  // coexist in the same list). null due_at means "no deadline set."
  due_at           DateTime? @db.Timestamptz(6)
  is_datetime      Boolean   @default(false)
  // Opt-in per todo, off by default — only meaningful when due_at is set
  // (enforced in the API layer, not here). Included on the .ics feed and
  // Google Calendar sync alongside items/lectures when true.
  show_on_calendar Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, due_at], map: "idx_todos_user_due_at")
}

// Named "User" (PascalCase) rather than following the rest of this schema's
// lowercase-plural introspected style, because @next-auth/prisma-adapter
// (v1, for next-auth v4) hardcodes its Prisma Client calls to
// prisma.user / prisma.account / prisma.session / prisma.verificationToken
// — those exact model names are load-bearing, not just style. @@map keeps
// the actual table name unchanged.
model User {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique
  name             String?
  image            String?
  emailVerified    DateTime?          @map("email_verified") @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  calendar_feeds   calendar_feeds[]
  courses          courses[]
  extracurriculars extracurriculars[]
  todos            todos[]
  accounts         Account[]
  sessions         Session[]
  gemini_usage     gemini_usage[]
  gemini_errors    gemini_errors[]
  study_guides     study_guides[]

  @@map("users")
}

// One row per (user, UTC calendar day) — tracks how many Gemini-backed calls
// (syllabus extraction, lecture-preview generation, transcript summary) a
// user has made today, enforced as a shared daily cap across all three (see
// lib/geminiUsage.ts) rather than a separate limit per feature, since what's
// being protected is total Gemini spend/call volume for the account.
model gemini_usage {
  id      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String   @db.Uuid
  date    DateTime @db.Date
  count   Int      @default(0)
  user    User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, date])
}

// One row per failed Gemini request attempt (including each model tried
// during fallback), so there's a lasting record of which features hit
// capacity/quota limits and when — Vercel's Hobby-plan runtime logs expire
// too quickly to answer that after the fact. user_id is who the request was
// for (the lecture's owner for cron-generated previews) so the AI usage page
// in Settings shows each user only their own errors. Pruned to the last 30
// days by the daily preview cron.
model gemini_errors {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user_id    String?  @db.Uuid
  feature    String
  model      String
  status     Int?
  message    String
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at])
  @@index([user_id, created_at])
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum item_source {
  extracted
  manual
}

enum item_status {
  not_started
  in_progress
  done
}

enum item_type {
  assignment
  quiz
  midterm
  final_exam
  project
  peer_evaluation
  other
}

enum preview_status {
  not_generated
  generated
  viewed
}

enum sync_target_type {
  ics_subscriber
  google_oauth
}
