generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model calendar_feeds {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String                  @db.Uuid
  feed_token            String                  @unique
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  user                  User                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  calendar_sync_targets calendar_sync_targets[]
}

model calendar_sync_targets {
  id                      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  feed_id                 String           @db.Uuid
  target_type             sync_target_type
  label                   String?
  google_access_token     String?
  google_refresh_token    String?
  google_token_expires_at DateTime?        @db.Timestamptz(6)
  created_at              DateTime         @default(now()) @db.Timestamptz(6)
  calendar_feeds          calendar_feeds   @relation(fields: [feed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model courses {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String     @db.Uuid
  course_code String
  course_name String
  semester    String?
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items       items[]
  lectures    lectures[]
  syllabi     syllabi[]

  @@index([user_id], map: "idx_courses_user")
}

model extracurriculars {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  title      String
  content    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model items {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id   String      @db.Uuid
  name        String
  type        item_type
  due_at      DateTime    @db.Timestamptz(6)
  is_datetime Boolean     @default(false)
  weight      String?
  notes       String?
  status      item_status @default(not_started)
  source      item_source @default(extracted)
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  courses     courses     @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_items_course")
  @@index([due_at], map: "idx_items_due_at")
}

model lectures {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id       String         @db.Uuid
  scheduled_at    DateTime       @db.Timestamptz(6)
  week_number     Int?
  topics          String?
  slides_url      String?
  preview_status  preview_status @default(not_generated)
  preview_content String?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  courses         courses        @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "idx_lectures_course")
  @@index([scheduled_at], map: "idx_lectures_scheduled_at")
}

model schema_migrations {
  name       String   @id
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

model syllabi {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course_id      String   @db.Uuid
  file_url       String
  raw_extraction Json?
  uploaded_at    DateTime @default(now()) @db.Timestamptz(6)
  courses        courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model todos {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  title            String
  done             Boolean   @default(false)
  // Optional, unlike items.due_at — a todo is a lighter task that may or may
  // not carry a deadline (Apple Reminders-style: dated and undated items
  // coexist in the same list). null due_at means "no deadline set."
  due_at           DateTime? @db.Timestamptz(6)
  is_datetime      Boolean   @default(false)
  // Opt-in per todo, off by default — only meaningful when due_at is set
  // (enforced in the API layer, not here). Included on the .ics feed and
  // Google Calendar sync alongside items/lectures when true.
  show_on_calendar Boolean   @default(false)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, due_at], map: "idx_todos_user_due_at")
}

// Named "User" (PascalCase) rather than following the rest of this schema's
// lowercase-plural introspected style, because @next-auth/prisma-adapter
// (v1, for next-auth v4) hardcodes its Prisma Client calls to
// prisma.user / prisma.account / prisma.session / prisma.verificationToken
// — those exact model names are load-bearing, not just style. @@map keeps
// the actual table name unchanged.
model User {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String             @unique
  name             String?
  image            String?
  emailVerified    DateTime?          @map("email_verified") @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  calendar_feeds   calendar_feeds[]
  courses          courses[]
  extracurriculars extracurriculars[]
  todos            todos[]
  accounts         Account[]
  sessions         Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum item_source {
  extracted
  manual
}

enum item_status {
  not_started
  in_progress
  done
}

enum item_type {
  assignment
  quiz
  midterm
  final_exam
  project
  peer_evaluation
  other
}

enum preview_status {
  not_generated
  generated
  viewed
}

enum sync_target_type {
  ics_subscriber
  google_oauth
}
