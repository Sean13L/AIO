DATABASE_URL="postgres://postgres:postgres@localhost:5432/syllabus_assistant"
PORT=4100
STORAGE_ROOT=./data

# Shared secret the web app uses to authenticate uploads/text-extraction
# calls to this worker. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
PREVIEW_LEAD_HOURS=48
PREVIEW_POLL_INTERVAL_MINUTES=15
